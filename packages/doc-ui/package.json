{
  "name": "@k-kinzal/doc-ui",
  "version": "1.0.0",
  "description": "Shared CSS for documentation, catalogs and reports",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./dist/document-design.css",
    "./js": "./dist/document-design.js",
    "./tokens": "./dist/document-design.tokens.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/contrast.mjs && node scripts/drawing-type.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "prepare": "npm run build",
    "dev": "npm run storybook"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "browserslist": "^4.28.0",
    "lightningcss": "^1.33.0",
    "storybook": "^10.6.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0"
  }
}
